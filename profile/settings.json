{
//------------------general-------------------------------//
  // -------------------- VIM SETUP ------------------------//
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-s>": false,
    "<C-z>": false
  },


  "vim.leader": " ",
  "vim.useSystemClipboard": true,
  "vim.incsearch": true,
  "vim.smartcase": true,
  "vim.highlightedyank.enable": true,
  "vim.searchHighlightColor": "findMatchHighlightBackground",
  "vim.searchHighlightTextColor": "#ffffff",
  "vim.highlightedyank.color": "rgba(250, 240, 170, 0.5)",
  "vim.highlightedyank.textColor": "#ffffff",
  "vim.hlsearch": true,
  "vim.scroll": 25,
  "vim.autoindent": true,

//-------------------------- COLORS ------------------------//
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#434b6d"
  },

//--------------------------- EDITOR -----------------------//
//  "editor.fontFamily": "Courier Screenplay, Courier Prime Code, Courier New, monospace",
  "editor.minimap.enabled": false,
  "editor.rulers": [80],
  "editor.tabSize": 2,
  "editor.lineNumbers": "relative",
  "editor.scrollbar.horizontal": "visible",
  "editor.fontLigatures": false,

  "editor.suggestSelection": "first",

  "editor.detectIndentation": false,
  "editor.parameterHints.enabled": false,
  "editor.acceptSuggestionOnCommitCharacter": false,

  "editor.inlineSuggest.enabled": false,

  "editor.quickSuggestionsDelay": 10,
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },
  "editor.wordBasedSuggestions": "off",
  "editor.hover.enabled": "off",
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",

  "editor.codeActionsOnSave": {},

  // workbench
  "workbench.sideBar.location": "right",
  "workbench.editorAssociations": { "*.pdf": "default" },
  "workbench.startupEditor": "none",

//------------------- cSpell dictionary --------------------//
  "cSpell.userWords": [
    "acri","ahbclk","clocktype","cohda","dout","gpio","gpioa","gpiob",
    "gpioc","gpiod","gpioe","gpiof","gpiog","gpioh","haurt","hclk",
    "hdma","hrtc","htim","huart","leds","lowpower","mdio","neopixel",
    "netbuf","netconn","palavikas","pclk","pllclk","rmii","segger",
    "sysclk","systick","sysview","uart","udid","usart"
  ],

//-------------------------- TERMINAL ----------------------//
// "terminal.integrated.cwd": "${workspaceFolder}",
//  "terminal.integrated.cursorStyle": "line",
//  "terminal.integrated.fontFamily": "Hack Nerd Font",
//  "terminal.integrated.defaultProfile.linux": "zsh",
//  "terminal.integrated.defaultProfile.windows": "Git Bash",
//  "terminal.integrated.profiles.windows": {},

//------------------------ GIT / GH ------------------------//
//  "gitlens.graph.layout": "editor",
//  "git.autofetch": true,
//  "diffEditor.ignoreTrimWhitespace": false,
//  "git.openRepositoryInParentFolders": "always",

//------------------------ Error Lens ----------------------//
  // Extension keys are case-sensitive ("errorLens.*")
  "errorLens.excludeBySource": [
    "\"cspell\"",
    "code-spell-checker"
  ],
  "errorLens.delay": 800,
  "errorLens.delayMode": "debounce",
  "errorLens.respectUpstreamEnabled": { "statusBar": true },

//------------------------- TODO Tree ----------------------//
  "todo-tree.general.tags": [ "bug", "hack", "fixme", "todo", "xxx" ],

//------------------------- Misc ---------------------------//
  "chat.commandCenter.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,


//---------------------PROFILE----------------------------//
//-------------------- VS CODE ---------------------------//
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.iconTheme": "gruvbox-material-icon-theme"

}
